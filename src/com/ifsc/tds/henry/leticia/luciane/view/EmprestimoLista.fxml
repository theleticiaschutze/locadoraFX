<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane fx:id="pnlPrincipal" minHeight="0.0" minWidth="0.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ifsc.tds.henry.leticia.luciane.controller.EmprestimoListaController">
   <children>
      <SplitPane fx:id="pnlDivisao" dividerPositions="0.4" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <items>
            <AnchorPane fx:id="pnlEsquerda" minHeight="0.0" minWidth="0.0" prefHeight="398.0" prefWidth="200.0">
               <children>
                  <TableView fx:id="tbvEmprestimos" prefHeight="398.0" prefWidth="236.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <columns>
                        <TableColumn fx:id="tbcCodigo" prefWidth="60.0" text="Código" />
                        <TableColumn fx:id="tbcCliente" prefWidth="90.0" text="Cliente" />
                        <TableColumn fx:id="tbcFilme" prefWidth="90.0" text="Filme" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </AnchorPane>
            <AnchorPane fx:id="pnlDireita" minHeight="0.0" minWidth="0.0" prefHeight="398.0" prefWidth="356.0">
               <children>
                  <Label fx:id="lblDetalhes" style="-fx-font-weight: bold;" text="Detalhes" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                  <GridPane fx:id="pnlDetalhes" layoutX="10.0" layoutY="45.0" prefHeight="220.0" prefWidth="336.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="45.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="140.0" minWidth="10.0" prefWidth="130.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="206.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label fx:id="lblCliente" text="Nome do Cliente:" />
                        <Label fx:id="lblClienteValor" GridPane.columnIndex="1" />
                        <Label fx:id="lblFilme" text="Filme Emprestado:" GridPane.rowIndex="1" />
                        <Label fx:id="lblFilmeValor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label fx:id="lblDataEmprestimo" text="Data Empréstimo:" GridPane.rowIndex="2" />
                        <Label fx:id="lblDataEmprestimoValor" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label fx:id="lblDataDevolucao" text="Data Devolução:" GridPane.rowIndex="3" />
                        <Label fx:id="lblDataDevolucaoValor" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label fx:id="lblObservacao" text="Observação:" GridPane.rowIndex="4" />
                        <Label fx:id="lblObservacaoValor" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
                  <ButtonBar fx:id="barBotoes" layoutX="146.0" layoutY="344.0" prefHeight="40.0" prefWidth="200.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
                    <buttons>
                      <Button fx:id="btnIncluir" mnemonicParsing="false" onAction="#onClickBtnIncluir" text="Incluir">
                           <tooltip>
                              <Tooltip fx:id="tlpIncluir" text="Incluir" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onClickBtnEditar" text="Editar">
                           <tooltip>
                              <Tooltip fx:id="tlpEditar" text="Editar" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#onClickBtnExcluir" text="Excluir">
                           <tooltip>
                              <Tooltip fx:id="tlpExcluir" text="Excluir" />
                           </tooltip>
                        </Button>
                    </buttons>
                  </ButtonBar>
               </children>
            </AnchorPane>
         </items>
      </SplitPane>
   </children>
</AnchorPane>